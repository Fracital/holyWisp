# holyWisp C style. STYLE.md is the prose version; this file is the enforcement.
# `make format` rewrites, `make check-format` verifies (CI runs the latter).
---
Language: Cpp
BasedOnStyle: LLVM
Standard: Latest

# Layout
ColumnLimit: 120
UseTab: ForIndentation
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 4
IndentCaseLabels: false
IndentPPDirectives: None
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: false
InsertNewlineAtEOF: true

# Braces: K&R, attached everywhere (functions included)
BreakBeforeBraces: Attach
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true
AllowShortEnumsOnASingleLine: false
InsertBraces: false

# Pointers bind to the name: `char *p`, never `char* p`
PointerAlignment: Right
DerivePointerAlignment: false
QualifierAlignment: Left
SpaceAroundPointerQualifiers: Default

# Spacing
SpaceAfterCStyleCast: false
SpaceBeforeParens: ControlStatements
SpacesInParentheses: false
SpacesInSquareBrackets: false
SpaceInEmptyParentheses: false
SpacesBeforeTrailingComments: 1
BitFieldColonSpacing: Both

# Line breaking
BinPackArguments: true
BinPackParameters: true
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignConsecutiveMacros: Consecutive
AlignEscapedNewlines: Left
AlignOperands: Align
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: true
BreakStringLiterals: false
ReflowComments: true
PenaltyBreakAssignment: 40
PenaltyReturnTypeOnItsOwnLine: 1000

# Includes: own header, then project headers, then system; each block sorted.
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"holywisp/'
    Priority: 1
  - Regex: '^"'
    Priority: 2
  - Regex: '^<(sys|netinet|arpa|linux)/'
    Priority: 4
  - Regex: '^<'
    Priority: 3
IncludeIsMainRegex: '$'

# Misc
AttributeMacros: [HW_UNUSED, HW_PRINTF]
ForEachMacros: []
StatementMacros: []
WhitespaceSensitiveMacros: []
