# holyWisp configuration. Every key is also a --key command-line flag; flags win.
# Values are plain words or "quoted strings"; booleans are on/off, true/false, 1/0.
# Lines starting with # are comments. Lists are built by repeating the key.

# ---------------------------------------------------------------- listening
host =
port = 6001
workers = 0                      # 0 = one per CPU
log-level = info                 # debug | info | warn | error | none

# ---------------------------------------------------------------- what clients may reach
allow-tcp = on
allow-udp = on
allow-direct-ip = off            # literal IPs in CONNECT
allow-private = off              # RFC 1918, CGNAT, fc00::/7
allow-loopback = off
allow-link-local = off
# allow-host = example.com       # when any allow-host is set, only those (and *.suffix) pass
# block-host = *.internal.corp
# allow-port = 80
# allow-port = 443
# block-port = 25
# block-port = 6000-6100

# ---------------------------------------------------------------- protocol
enable-v2 = on
enable-twisp = off               # PTY streams; needs v2 and an authenticated client
motd =
# password-user = alice:$2b$12$...hash...   # crypt(3) hashes ($2b$, $6$, $y$) or plain text
password-required = off
buffer-remaining = 128

# ---------------------------------------------------------------- who the client is
parse-real-ip = on
# trusted-proxy = 127.0.0.1
# trusted-proxy = 10.0.0.0/8
# The header the proxy in front rewrites. X-Forwarded-For is the default; name another only if
# that proxy sets it itself (CF-Connecting-IP is safe behind Cloudflare and nowhere else: any other
# proxy passes the client's own copy through). `trusted-headers-reset` empties the list first.
# trusted-headers-reset = on
# trusted-header = CF-Connecting-IP
# A proxy on the same host shares its address with every local process. With a secret set, the
# proxy headers count only on requests that also carry `X-HolyWisp-Proxy-Secret: <value>`.
# trusted-proxy-secret = change-me
# Origins a browser may connect from, one per line, each scheme://host[:port]. With none, any page
# on the web can open a connection through its visitor's browser, and what that page does is held
# against the visitor's address. A request without an Origin header (not a browser) is not refused.
# allow-origin = https://app.example

# ---------------------------------------------------------------- per-client limits
connections-limit-per-ip = 200   # new WebSockets per IP per window (0 = off)
connection-window-s = 10
bandwidth-limit-kbps = 0         # per IP, each direction (0 = off)
max-streams-per-conn = 2048

# ---------------------------------------------------------------- flood protection
flood-protection = on
max-connects-per-source-per-second = 500
max-connects-per-dest-per-second = 100
max-connects-per-dest-per-minute = 3000
max-in-flight-syns = 4096
max-in-flight-syns-per-ip = 512  # of those, how many one client address may hold
max-concurrent-connections = 50000
max-concurrent-connections-per-ip = 5000   # of those, how many one client address may hold
syn-signature = on
syn-signature-window-ms = 2000
syn-signature-min-samples = 128
syn-signature-failed-ratio = 0.75
ws-close-after-violations = 64
log-blocked-dials = off

# ---------------------------------------------------------------- reputation
reputation = on
reputation-store = ./data/reputation.json
reputation-save-interval-s = 30
reputation-decay-per-hour = 1
reputation-evict-after-days = 7
reputation-warn = 21
reputation-throttle = 51
reputation-strict = 81
# reputation-weight = synSignature:25          # source weights, event:points
# privateEgress is 0 by default: a page can make its visitor's browser ask for a private address,
# so the attempt is refused (0x48) and counted in /stats but not held against the address.
# reputation-weight = privateEgress:15
# reputation-dest-weight = synSignature:30

# ---------------------------------------------------------------- where streams go
# Upstream proxy for every outbound TCP stream. The proxy receives the destination hostname as the
# client gave it (SOCKS5 ATYP 3 domain, CONNECT host:port), so it can resolve, classify or route by
# name; socks5h:// is accepted as an alias. The name is still resolved and policy-checked here first.
# proxy = socks5://user:pass@127.0.0.1:1080  # or http://host:3128
# UDP cannot go through the proxy: refuse it (default) or relay it directly, bypassing the proxy.
# proxy-udp = refuse                         # refuse | direct
# dns-server = 1.1.1.1
# dns-server = [2606:4700:4700::1111]:53
dns-ttl-s = 120
dns-negative-ttl-s = 10
dns-order = ipv4first            # ipv4first | ipv6first | verbatim
dns-timeout-ms = 3000

# ---------------------------------------------------------------- tuning
# A full buffer-remaining window of maximum-size packets must fit in stream-queue-max, or a client
# sending at full speed into a slow remote would be closed (0x49) before flow control ever slowed
# it; the advertised window is capped to make that true (logged at startup when it bites). With
# these defaults the window is the full 128. conn-queue-max bounds what one client can have queued
# toward slow remotes across all its streams: past it the server stops reading that client until
# the remotes drain, so a client with many stalled streams costs bounded memory and nothing closes.
max-message-size = 1048581
ws-write-high-water = 8388608
stream-queue-max = 134217728
conn-queue-max = 268435456
socket-buffer-size = 0           # SO_RCVBUF/SO_SNDBUF on every socket; 0 = kernel default
# With socket-buffer-size = 0, client sockets get this receive buffer so uploads arrive in large
# reads. It is applied only when net.core.rmem_max grants at least 4 MiB (the kernel doubles the
# value, so rmem_max >= 2097152); below that the kernel's autotuning is left alone. 0 = never.
client-recv-buffer = 8388608
connect-timeout-ms = 15000
handshake-timeout-ms = 10000
# A client that takes nothing of what is queued for it for this long is closed. Its queue is bounded
# either way (the server stops reading from it at twice ws-write-high-water); this ends the wait.
client-write-timeout-s = 120     # 0 = never
# A connection with no bytes in either direction for this long is closed with 1001. Off by default:
# a client with an open tab and nothing to say is not misbehaving.
idle-timeout-s = 0
resolver-threads = 4
# After a loop iteration that delivered events, a worker polls this many microseconds before it
# sleeps. A busy relay is usually woken again within microseconds, so a short poll (50 is a good
# start) lowers round-trip latency; the cost is CPU time spent waiting. 0 = always sleep.
busy-poll-us = 0
tcp-nodelay = on
tcp-quickack = on
listen-backlog = 1024
non-ws-response = "holyWisp: a Wisp server. Connect with a WebSocket client."
serve-webclient = on                # show the built-in browser client on GET /
webclient-wisp-url =                # ws(s):// URL the web client offers by default; empty = this origin
stop-on-stdin-eof = off             # shut down when stdin closes; only for a parent process holding a pipe
