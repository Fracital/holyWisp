#!/bin/sh
# Disable the unit on removal; drop config and state on purge. The wisp system user is left in
# place, per Debian policy on system accounts.
set -e

case "$1" in
remove)
	if [ -d /run/systemd/system ]; then
		systemctl disable holywisp.service >/dev/null 2>&1 || true
		systemctl daemon-reload >/dev/null 2>&1 || true
	fi
	;;
purge)
	if [ -d /run/systemd/system ]; then
		systemctl disable holywisp.service >/dev/null 2>&1 || true
		systemctl daemon-reload >/dev/null 2>&1 || true
	fi
	rm -rf /etc/holywisp /var/lib/holywisp
	;;
esac

exit 0
