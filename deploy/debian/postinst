#!/bin/sh
# holyWisp Debian postinst: create the isolated wisp user, own the config and state directories,
# and start the hardened systemd unit.
set -e

UNIT=holywisp.service

case "$1" in
configure)
	# A locked system group and user with no login shell and the state dir as home. The account
	# exists only to run the server: it cannot be logged into and owns nothing else on the host.
	if ! getent group wisp >/dev/null; then
		addgroup --system wisp
	fi
	if ! getent passwd wisp >/dev/null; then
		adduser --system --home /var/lib/holywisp --no-create-home --ingroup wisp \
			--disabled-password --disabled-login --shell /usr/sbin/nologin \
			--gecos "holyWisp Wisp server" wisp
	fi

	# Config is root-owned and group-readable by wisp (it may hold password hashes), never
	# world-readable. State is owned by wisp.
	mkdir -p /etc/holywisp /var/lib/holywisp
	chown root:wisp /etc/holywisp
	chmod 0750 /etc/holywisp
	if [ -f /etc/holywisp/holywisp.conf ]; then
		chown root:wisp /etc/holywisp/holywisp.conf
		chmod 0640 /etc/holywisp/holywisp.conf
	fi
	chown wisp:wisp /var/lib/holywisp
	chmod 0750 /var/lib/holywisp

	# systemd: reload, enable, (re)start, but only when systemd is actually running (not in a
	# container image build, for instance).
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload >/dev/null 2>&1 || true
		systemctl enable "$UNIT" >/dev/null 2>&1 || true
		systemctl restart "$UNIT" >/dev/null 2>&1 || true
	fi
	;;
esac

exit 0
